+            continue;
+        seen |= dmesh_native_peek(ctx->transport, stripe);
+    }
+    uint64_t anchor = eq_watch_anchor(eq);
+    uint64_t until = watch_until(ctx, anchor, atomic_load_explicit(&eq->last_work_ns, memory_order_relaxed));
+    uint64_t since = atomic_load_explicit(&eq->watch_since_ns, memory_order_relaxed);
+    int wake = 0;
+    if (seen & DMESH_PEEK_WORK) {
