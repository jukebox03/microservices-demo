+static uint64_t watcher_scan(dpumesh_ctx_t *ctx, uint64_t now)
+{
+    uint64_t earliest = UINT64_MAX;
+    uint32_t active = 0;
+    int have_active = 0;
+    pthread_mutex_lock(&ctx->eq_lock);
+    for (int i = 0; i < ctx->n_eqs; ++i) {
+        struct dmesh_eq *eq = ctx->eqs[i];
+        if (eq == NULL) continue;
+        uint64_t due = atomic_load_explicit(&eq->watch_due_ns, memory_order_seq_cst);
+        if (due == 0) continue;
+        if (due <= now) {
+            if (!have_active) { active = dmesh_native_active(ctx->transport); have_active = 1; }
+            due = watch_check(ctx, eq, due, active, now);
+            if (due == 0) continue;
+        }
+        if (due < earliest) earliest = due;
+    }
+    pthread_mutex_unlock(&ctx->eq_lock);
+    return earliest;
