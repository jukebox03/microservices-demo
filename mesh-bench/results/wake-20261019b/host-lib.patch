+/* The idle watcher's peek reports what a poll would deliver without taking
+ * it, and leaves a slot another thread holds alone. */
+static uint64_t consumed;
+static int rx_ready;
+uint64_t channel_conn_consumed(const struct channel_conn *conn) { (void)conn; return consumed; }
+int channel_conn_rx_ready(const struct channel_conn *conn) { (void)conn; return rx_ready; }
+
+static void test_watcher_peek(void)
+{
+    struct dmesh_native_transport *t = calloc(1, sizeof(*t));
+    assert(t);
+    struct slot *s = &t->slots[0];
+    assert(pthread_mutex_init(&s->lock, NULL) == 0);
+    assert(dmesh_native_peek(t, -1) == 0 && dmesh_native_peek(t, SLOTS) == 0);
+    assert(dmesh_native_peek(t, 0) == 0);                       /* free slot */
+    s->state = SLOT_OPEN;
+    s->conn = (struct channel_conn *)t;                         /* never dereferenced here */
+    assert(dmesh_native_peek(t, 0) == 0);
+    rx_ready = 1;
+    assert(dmesh_native_peek(t, 0) == DMESH_PEEK_WORK);
+    rx_ready = 0;
+    s->tickets[0] = (struct ticket){1, 5};
+    s->t_tail = 1;
+    consumed = 4;
+    assert(dmesh_native_peek(t, 0) == DMESH_PEEK_CUSTODY);      /* not consumed yet */
+    consumed = 5;
+    assert(dmesh_native_peek(t, 0) == DMESH_PEEK_WORK);         /* its ACK is due */
+    assert(pthread_mutex_lock(&s->lock) == 0);
+    assert(dmesh_native_peek(t, 0) == 0);                       /* held: looked at later */
+    assert(pthread_mutex_unlock(&s->lock) == 0);
+    s->t_head = 1;
+    s->state = SLOT_CLOSED;
+    s->conn = NULL;
+    assert(dmesh_native_peek(t, 0) == 0);
+    s->fin_pending = 1;
+    assert(dmesh_native_peek(t, 0) == DMESH_PEEK_WORK);         /* retirement pending */
+    pthread_mutex_destroy(&s->lock);
+    free(t);
+}
