+}
+uint32_t dmesh_native_active(struct dmesh_native_transport *t)
+{
+    return __atomic_load_n(&t->active_stripes, __ATOMIC_ACQUIRE);
+}
+/* The checks of dmesh_native_poll, minus the peer-gone report (a control
+ * message, seen once the control PE progresses). A held lock means another
+ * thread is polling or closing the slot, so the watcher looks again later. */
+int dmesh_native_peek(struct dmesh_native_transport *t, int stripe)
+{
+    if (stripe < 0 || stripe >= SLOTS) return 0;
+    struct slot *s = &t->slots[stripe];
+    if (__atomic_load_n(&s->state, __ATOMIC_ACQUIRE) == SLOT_FREE) return 0;
+    if (pthread_mutex_trylock(&s->lock) != 0) return 0;
+    int r = 0;
+    if (s->state == SLOT_OPEN && s->conn) {
+        if (s->t_head != s->t_tail)
+            r |= s->tickets[s->t_head % TICKETS].ticket <= channel_conn_consumed(s->conn) ?
+                 DMESH_PEEK_WORK : DMESH_PEEK_CUSTODY;
+        if (channel_conn_rx_ready(s->conn)) r |= DMESH_PEEK_WORK;
+    } else if (s->state == SLOT_CLOSED && (s->t_head != s->t_tail || s->fin_pending)) {
+        r |= DMESH_PEEK_WORK;
+    }
+    pthread_mutex_unlock(&s->lock);
+    return r;
+}
 void dmesh_native_stripe_clear(struct dmesh_native_transport *t, int stripe)
 {
     if (stripe < 0 || stripe >= SLOTS) return;
