+
+/* One check of a watched EQ whose due time has come. Returns its next due,
+ * or 0 after waking it. A stripe owned by another EQ is that EQ's to wake;
+ * one being drained will be delivered by its drainer. */
+static uint64_t watch_check(dpumesh_ctx_t *ctx, struct dmesh_eq *eq, uint64_t due,
+                            uint32_t active, uint64_t now)
+{
+    int seen = 0;
+    atomic_fetch_add_explicit(&wait_stats.watch_checks, 1, memory_order_relaxed);
+    for (int stripe = 0; stripe < ctx->landing_stripes; ++stripe) {
+        if (!(active & (UINT32_C(1) << stripe))) continue;
+        struct dmesh_eq *owner = __atomic_load_n(&ctx->stripe_owner[stripe], __ATOMIC_ACQUIRE);
+        if ((owner != NULL && owner != eq) ||
