+/* ====================================================================
+ * Idle watcher (DPUMESH_WATCHER=1)
+ *
+ * An EQ that ran empty within its nap or linger window hands its polls to
+ * one thread per channel instead of re-polling on its own timer. The
+ * watcher keeps the same schedule, but a check is a few loads per stripe
+ * (dmesh_native_peek) rather than a wake of the application's event loop
+ * and a full drain. It wakes the EQ through its eventfd when a peek finds
+ * work, and at the end of the window so the EQ arms its doorbells and
+ * sleeps as before. Custody ACKs have no doorbell: while one is
+ * outstanding the watcher keeps polling past the window, waking the EQ
+ * once per WATCH_REFRESH_NS so its control events are not held back.
+ * ==================================================================== */
+#define WATCH_REFRESH_NS 1000000ull
+
+/* The next check after now on the ladder that started at `anchor` (work, a
+ * send or a DOORBELL): nap_min doubling while within nap_cap, then every
+ * nap_cap, the times the EQ's own timer would have fired. */
+static uint64_t watch_next(const dpumesh_ctx_t *ctx, uint64_t anchor, uint64_t now)
+{
+    uint64_t cap = ctx->nap_cap_ns, step = ctx->nap_min_ns ? ctx->nap_min_ns : cap;
+    uint64_t t = anchor + step;
+    while (t <= now && step < cap) {
+        step = step * 2 < cap ? step * 2 : cap;
+        t += step;
+    }
+    if (t <= now) t += ((now - t) / cap + 1) * cap;
+    return t;
+}
+
+/* The window ends after the naps from the anchor and the linger from the
+ * last work or send, whichever is later. */
+static uint64_t watch_until(const dpumesh_ctx_t *ctx, uint64_t anchor, uint64_t last)
+{
+    uint64_t naps = anchor + ctx->nap_span_ns, linger = ctx->linger_ns ? last + ctx->linger_ns : 0;
+    return naps > linger ? naps : linger;
+}
+
+static uint64_t eq_watch_anchor(struct dmesh_eq *eq)
+{
+    uint64_t anchor = atomic_load_explicit(&eq->watch_anchor_ns, memory_order_relaxed);
+    uint64_t last = atomic_load_explicit(&eq->last_work_ns, memory_order_relaxed);
+    return anchor > last ? anchor : last;
+}
+
+/* Hand an idle EQ to the watcher. The EQ's thread sleeps on its fd as
+ * before, with the backstop as the bound on a missed wake. The kick pairs
+ * with the watcher's look after publishing watcher_until: either the
+ * watcher sees this due, or this sees the sleep it must cut short. */
+static void eq_watch(struct dmesh_eq *eq, uint64_t now)
+{
+    dpumesh_ctx_t *ctx = eq->ch->ctx;
+    uint64_t due = watch_next(ctx, eq_watch_anchor(eq), now);
+    if (eq->tick_deadline_ns < now + ctx->backstop_ns / 2)
+        eq_timer(eq, ctx->backstop_ns, 1);
+    else
+        eq->timer_backstop = 1;            /* still the backstop of an earlier hand-off */
+    atomic_store_explicit(&eq->watch_since_ns, now, memory_order_relaxed);
+    atomic_fetch_add_explicit(&wait_stats.watches, 1, memory_order_relaxed);
+    atomic_store_explicit(&eq->watch_due_ns, due, memory_order_seq_cst);
+    if (atomic_load_explicit(&ctx->watcher_until, memory_order_seq_cst) > due) {
+        uint64_t one = 1;
+        ssize_t w = write(ctx->watcher_efd, &one, sizeof(one));
+        (void)w;
+        atomic_fetch_add_explicit(&wait_stats.watch_kicks, 1, memory_order_relaxed);
+    }
