<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.HealthCheck" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Google.Cloud.Spanner.Data" Version="5.12.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="protos\Cart.proto" GrpcServices="Both" />
  </ItemGroup>
  <!-- Built with DPUMESH_ROOT, the service can serve gRPC over DPUMesh
       (DPUMESH_ENABLE=1); without it, it builds as upstream. -->
  <PropertyGroup Condition="'$(DPUMESH_ROOT)' != ''">
    <DefineConstants>$(DefineConstants);DPUMESH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DPUMESH_ROOT)' != ''">
    <ProjectReference Include="$(DPUMESH_ROOT)/integrations/grpc/dotnet/src/Dpumesh.Grpc/Dpumesh.Grpc.csproj" />
  </ItemGroup>

</Project>
